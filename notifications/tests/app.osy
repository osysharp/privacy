// The producer's test project for Osysharp.Privacy.Notifications — the smallest correct consumer: a team that tells each
// other things and answers privacy requests. A teammate asks for her data, and then to be erased; her notifications and
// her preferences go with her, and nobody else's.
app PrivacyNotificationsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.Accounts@0;
  use Osysharp.Collaboration@0;
  use Osysharp.Inbox@0;
  use Osysharp.ServiceHours;
  use Osysharp.Mail@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.Notifications@1;
  use Osysharp.Privacy@0;
  // Osysharp.Privacy.Notifications, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and Notifications, which it completes (`osy lock` includes it and says so).
  use Osysharp.Observability;
}
