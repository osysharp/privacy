// Osysharp.Privacy.Notifications — what the app told a person, as Osysharp.Privacy's holder: their notifications and
// their notification preferences, found by their account, in their copy of their data, kept restricted when they ask,
// and erased when they ask.
//
// ⚑ AN ADAPTER, SO NEITHER KIT DEPENDS ON THE OTHER: Notifications does not force privacy requests on an app that only
//   tells people things, and Privacy does not force a bell on its apps. An app using both gets it by itself —
//   `completes` below, and `osy lock` says so — the holder is DISCOVERED, nothing is wired.
package Osysharp.Privacy.Notifications {
  version     "0.2.0";
  minPlatform "0.9.0";
  summary     "Osysharp.Privacy's holder for Osysharp.Notifications — a person's notifications and their preferences, found by their account, in their copy of their data, kept restricted on request and erased when they ask.";
  completes   Osysharp.Privacy@0, Osysharp.Notifications@1;
  model "model/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.Notifications@1;
  use Osysharp.Privacy@0;
  tests "tests";
}
