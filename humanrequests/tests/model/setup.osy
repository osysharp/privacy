// How the marina answers privacy requests. In a file of its own with no `namespace`.
using Osysharp.Privacy;
using Osysharp.WorkQueues;
using Marina;

app.Privacy = new PrivacySetup { Controller = "Northharbour Marina AB", SupervisoryAuthority = "IMY, imy.se", ReviewPlans = PlanReview.WhenJudgement };
app.Inbox = new InboxSetup { DefaultQueue = "Harbour" };
