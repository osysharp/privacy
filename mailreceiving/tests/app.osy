// The producer's test project for Osysharp.Privacy.MailReceiving — the smallest correct consumer: a desk that reads a
// mailbox and answers privacy requests. A person who mailed it asks to be erased; what the mailbox received from them
// goes, and what it received from anybody else stays.
app PrivacyMailReceivingKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.Accounts@0;
  use Osysharp.Collaboration@0;
  use Osysharp.Inbox@0;
  use Osysharp.ServiceHours;
  use Osysharp.Mail@0;
  use Osysharp.Mail.Receiving@0;
  use Osysharp.Privacy@0;
  // Osysharp.Privacy.MailReceiving, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and Mail.Receiving, which it completes (`osy lock` includes it and says so).
  use Osysharp.Observability;
}
