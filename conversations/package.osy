// Osysharp.Privacy.Conversations — what the Conversations kit holds about a person, as Osysharp.Privacy's holder: which
// of it may be erased when they ask, which must be kept, and when each is gone for everyone.
//
//   conversations.claims         a conversation about a complaint or a dispute — kept for legal claims, 36 months from
//                                its last entry (the app says which conversations those are: `ConcernsAClaim`)
//   conversations.service        their other conversations — erased when they ask, and after `KeepForMonths` (the tenant may change it) for everyone
//   conversations.contact-points who they are: their addresses, numbers and name — erased when they ask
//   conversations.analysis       the redacted copies in the desk's language that search reads — erased when they ask
//
// ⚑ AN ADAPTER, SO NEITHER KIT DEPENDS ON THE OTHER: a team's own chat (`demo/chat-room`) uses Conversations and wants
//   no privacy queue, no Inbox and no Mail under it; Privacy does not force a timeline on its apps. An app using both
//   adds `use Osysharp.Privacy.Conversations@0;` — the holder is DISCOVERED, nothing is wired. The erasure itself is the
//   Conversations kit's own run (`PartyErasure`); this kit only says what the plan erases, and when a period ended.
//
// ⚑ A COMPLAINT IS KEPT RESTRICTED, NOT LEFT IN USE (D-PRIVACY1 R1, owner 2026-10-02). The Conversations kit classifies
//   its fields `Personal.*`, and every app maps those levels (`{ Open = true }`: whoever may read the row reads them), so
//   a customer still reads their own words. When they ask to be erased, a conversation that concerns a claim is
//   RESTRICTED — its entries, renderings, files and deliveries, and who they are — until its period ends: absent from
//   every ordinary read, read only through `ConversationForAClaim` (`HandlesClaims`, by default whoever places legal
//   holds), every read logged. The app keeps what it holds beside it the same way (`ConversationPrivacyRules.Kept`).
//   The daily purge lifts it and erases it on its day, and then who they were.
package Osysharp.Privacy.Conversations {
  version     "0.6.1";
  minPlatform "0.9.0";
  summary     "Osysharp.Privacy's holder for Osysharp.Conversations — complaints kept RESTRICTED for legal claims — read only for a claim, every read logged — while the rest of a person's conversations, their contact points and the redacted copies are erased on request, a daily purge that ends every conversation's period, the app's own say on which conversations concern a claim, and a person with no account proving their address to ask for themselves.";
  completes   Osysharp.Privacy@0, Osysharp.Conversations@0;
  model "model/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.Conversations@0;
  use Osysharp.Privacy@0;
  use Osysharp.Workflow;
  // A kept conversation is read only by a purpose read, and every one is written to the access trail.
  use Osysharp.Observability;
  tests "tests";
}
