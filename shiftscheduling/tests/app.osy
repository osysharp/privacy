// The producer's test project for Osysharp.Privacy.ShiftScheduling — the smallest correct consumer: a community kitchen with a
// volunteer rota that answers privacy requests. A volunteer's shifts, time off and cover requests are in their copy of
// their data, and go when they are erased — theirs, and nobody else's.
app PrivacyShiftSchedulingKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.ServiceHours;
  use Osysharp.WorkQueues@1;
  use Osysharp.Privacy@0;
  use Osysharp.ShiftScheduling@0;
  // Osysharp.Privacy.ShiftScheduling, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and ShiftScheduling, which it completes (`osy lock` includes it and says so).
}
