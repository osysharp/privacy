// The producer's test project for Osysharp.Privacy.IncidentReports — the smallest correct consumer: a public library
// whose staff record incidents and which answers privacy requests. A visitor who slipped on the stairs asks for a copy
// of what is held about them, and later to be erased.
app PrivacyIncidentReportsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.ServiceHours;
  use Osysharp.WorkQueues@1;
  use Osysharp.Privacy@0;
  use Osysharp.IncidentReports@0;
  // Osysharp.Privacy.IncidentReports, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and IncidentReports, which it completes (`osy lock` includes it and says so).
  use Osysharp.Storage;
  use Osysharp.Workflow;
  use Osysharp.Observability;
  use Osysharp.Ui;
}
