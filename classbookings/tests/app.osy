// The producer's test project for Osysharp.Privacy.ClassBookings — the smallest correct consumer: a yoga studio that takes
// class bookings and answers privacy requests. A member who leaves asks to be erased; their place passes on.
app PrivacyClassBookingsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.ServiceHours;
  use Osysharp.WorkQueues@1;
  use Osysharp.Privacy@0;
  use Osysharp.ClassBookings@0;
  // Osysharp.Privacy.ClassBookings, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and ClassBookings, which it completes (`osy lock` includes it and says so).
  use Osysharp.Workflow;
  use Osysharp.Observability;
  use Osysharp.Ui;
  use Osysharp.Oauth;
}
