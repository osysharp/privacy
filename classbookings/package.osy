// Osysharp.Privacy.ClassBookings — the bookings Osysharp.ClassBookings holds about a person, as Osysharp.Privacy's holder:
// every place they booked or waited for, when they came, cancelled late or did not come — in their copy of their data,
// and erased when they ask (a place they still hold passes to the next person waiting).
//
// ⚑ AN ADAPTER, SO NEITHER KIT DEPENDS ON THE OTHER: ClassBookings does not force privacy requests on an app that only
//   takes bookings, and Privacy does not force bookings on its apps. An app using both gets it by itself — `completes`
//   below, and `osy lock` says so — the holder is DISCOVERED, nothing is wired.
package Osysharp.Privacy.ClassBookings {
  version     "0.2.0";
  minPlatform "0.14.0";
  summary     "Osysharp.Privacy's holder for Osysharp.ClassBookings — the places a person booked or waited for, their attendance, late cancellations and no-shows: counted, in their copy of their data, and erased when they ask, a place they still held passing to the next person waiting.";
  completes   Osysharp.Privacy@0, Osysharp.ClassBookings@0;
  model "model/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.ClassBookings@0;
  use Osysharp.Privacy@0;
  tests "tests";
}
