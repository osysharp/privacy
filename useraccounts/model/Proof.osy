namespace Osysharp.Privacy.UserAccounts;

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Privacy;

/// Proves a signed-in Osysharp.UserAccounts person for a privacy request — discovered by Osysharp.Privacy.
public class AccountsRequesterProof : IRequesterProof {
  public string Key() => "Osysharp.UserAccounts";

  /// A code goes to the signed-in account's own address.
  public ProofStarted Start() {
    var s = StartStepUp(CodePurpose.PrivacyRequest);
    var me = User.Single(u => u.Id == Session.CurrentUser!.Id);
    return new ProofStarted { Id = s.Id, SentTo = MaskedEmail(me.Email) };
  }

  public string Prove(Guid proof, string code) {
    var s = StepUp.FirstOrDefault(x => x.Id == proof);
    if (s == null) { return "That code no longer works — ask for a new one."; }
    return ProveStepUp(s!, code);
  }

  public string Spend(Guid proof, Guid account, TimeSpan within) {
    return SpendStepUp(proof, account, CodePurpose.PrivacyRequest, within);
  }

  /// The account's own address, once it has proven it (`EmailVerifiedAt`) — "" before, and for a principal that is not
  /// an account of this kit's.
  public string ProvenAddress(Guid id) {
    var account = User.FirstOrDefault(u => u.Id == id);
    return account == null || account!.EmailVerifiedAt == null ? "" : account!.Email;
  }
}
