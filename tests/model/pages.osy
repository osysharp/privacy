// The desk's screens as an app places the kits' components: the inbox, where a privacy request is worked like any other
// item (the Privacy kit's pane beside the WorkQueues kit's header), and the customer's own privacy page (the kit's, at
// `/privacy`). Everything here is the APP's; every control on it is a kit's.
namespace PrivacyKitTests;

using Osysharp.Identity;
using Osysharp.WorkQueues;
using Osysharp.Privacy;
using Osysharp.Ui;

[Layout]
component DeskFrame() {
  live var me = Session.CurrentUser;
  live var myName = me == null ? "" : me.DisplayName;
  action SignOut() { Session.SignOut(); }
  render {
    InboxShell(new AppChrome {
      Product = "The Desk",
      Tagline = "Inbox",
      Mark = Icons.Inbox,
      Home = "/inbox/open",
      Panes = true,
      User = new ShellUser {
        Name = myName, Initials = InitialsOf(myName == "" ? "?" : myName), Presence = ShellPresence.Online,
        Menu = [ new MenuAction { Label = "Sign out", Icon = Icons.Logout, OnPress = SignOut, Tone = Tone.Danger } ],
      },
    }) {
      Outlet(retain: 4);
    }
  }
}

/// A view of the work.
[Route("/inbox/{view}")] [Layout(DeskFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Inbox")]
component InboxPage(string view) {
  render {
    InboxPanes(view, r => "/inbox/" + view + "/i/" + r.Id, Guid.Empty) { InboxOverview(view, noun: "request"); }
  }
}

/// An item open beside the list — a privacy request gets the Privacy kit's pane.
[Route("/inbox/{view}/i/{id}")] [Layout(DeskFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Item")]
component ItemPage(string view, Guid id) {
  live var items = WorkItem.Where(w => w.Id == id).Include(w => w.Queue).Include(w => w.Assignee).ToList();
  render {
    InboxPanes(view, r => "/inbox/" + view + "/i/" + r.Id, id) {
      Stack(gap: 0, grow: 1, minW: "0", h: "100%", minH: "0", overflowY: Overflow.Auto) {
        foreach (var item in items) {
          WorkItemHead(item);
          PrivacyRequestPane(item.Id);
        }
      }
    }
  }
}

/// A settings page with a known height — taller than the sections column's own links, shorter than the window a test
/// gives it — so a test can tell a nav that runs the window's height from one that stops where the page stops.
[Route("/settings/test/known-height")] [Layout(SettingsFrame)] [Authorize(ManagesPrivacy)] [Render(CSR)] [Title("Known height")]
component KnownHeightSettingsPage() {
  render { Box(label: "A page of a known height", h: "1000px", w: "100%") { Text("Nothing else is on this page."); } }
}
