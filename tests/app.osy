// The producer's test project for Osysharp.Privacy — the smallest correct consumer: a desk with customers, notes staff
// write about them, and vouchers the books must keep. A customer asks for their data or to be erased — through staff, or
// for themselves after proving it is them; the notes and the account go, the vouchers are kept restricted for the books
// until the right day, and only the bookkeeping export reads them. Every request is inbox work in a restricted "Privacy"
// queue, due one calendar month after it arrived. The fiscal year ends 30 June.
app PrivacyKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.Accounts@0;
  use Osysharp.Collaboration@0;
  use Osysharp.Inbox@0;
  use Osysharp.ServiceHours;
  use Osysharp.Mail@0;
  use Osysharp.Privacy@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
  use Osysharp.Observability;
  use Osysharp.Storage;
}
