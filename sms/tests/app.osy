// The producer's test project for Osysharp.Privacy.Sms — the smallest correct consumer: a desk that texts and answers
// privacy requests. A person whose number staff checked asks to be erased; the texts to that number go, and only those.
app PrivacySmsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.Accounts@0;
  use Osysharp.Collaboration@0;
  use Osysharp.Inbox@0;
  use Osysharp.ServiceHours;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.Privacy@0;
  // Osysharp.Privacy.Sms, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and Sms, which it completes (`osy lock` includes it and says so).
  use Osysharp.Observability;
}
