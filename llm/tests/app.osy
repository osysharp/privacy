// The producer's test project for Osysharp.Privacy.Llm — a phrasebook: travellers with an account ask for a phrase in
// another language, and a model writes it. The meter says who each call was made for. A traveller asks for her copy,
// and then to be erased: she is taken off the meter, and what her calls cost is still counted.
// No model is ever called: its one model is scripted.
app Phrasebook {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.WorkQueues@1;
  use Osysharp.ServiceHours;
  use Osysharp.Mail@0;
  use Osysharp.Privacy@0;
  use Osysharp.Llm@2;
  // Osysharp.Privacy.Llm, the package under test, is not written: it arrives by itself because this app uses Privacy
  // and Llm, which it completes (`osy lock` includes it and says so).
  use Osysharp.Observability;
  use Osysharp.Workflow;
  use Osysharp.Storage;
}
