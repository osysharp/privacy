namespace Osysharp.Privacy;

using Osysharp.WorkQueues;
using Osysharp.Storage;

// ── the platform's own holder: copies the platform and this kit keep ──────────────────────────────────────────────
//
// Declared so the records of processing and every response name them, and so the kit's own evidence has a period:
//   · privacy.records — the requests and plans this kit keeps (Art. 5(2) accountability): ids, counts, dates and the
//     address a request was about; LEGAL CLAIMS, 36 months from receipt by default, then purged.
//   · privacy.marks — the notes that a record of the app's is about a person (`MarkAbout`): how every holder finds
//     those records, so a request erases them LAST.
// The audit trail holds no personal value at all (fields classified `Personal.*` are recorded as changed, never as
// themselves), so it has nothing to declare. Nor does the platform keep any text sent to an AI model: what a call
// cost and who it ran for is `Osysharp.Llm`'s meter (held by `Osysharp.Privacy.Llm`), and what an agent was shown and
// answered is `Osysharp.Agents`' record (held by `Osysharp.Privacy.Agents`).

public class PlatformPersonalData : IPersonalDataHolder {
  public string Key() => "Osysharp.Privacy";

  public List<DataCategory> Categories() => [
    new DataCategory {
      Key = "privacy.records", Label = "Your requests to us about your data, and what we did about them",
      Purpose = Translate("Showing that we answered your requests (GDPR Art. 5(2))"), SubjectKind = "everyone who asked",
      Basis = RetentionBasis.LegalClaims, BasisDetail = "the establishment, exercise or defence of legal claims",
      RetainedMonths = 36, RetainedFrom = RetentionStart.Collected, MinMonths = 12, MaxMonths = 120,
      RetainedFromWords = Translate("from when you asked") },
    new DataCategory {
      Key = "privacy.marks", Label = "The notes that a record of ours is about you",
      Purpose = Translate("Finding the records about you when you ask to see them or to have them erased"),
      SubjectKind = "everyone", Basis = RetentionBasis.Contract,
      // How every other holder finds a record that was marked about somebody: erased last.
      Identifies = true },
  ];

  /// A request's own records are never what a request plans: the evidence of an erasure is not erased by it. They go
  /// at the end of their period, by `Purge`. The marks are counted, and go when the person asks.
  public int Count(DataSubject subject, DataCategory category) => category.Key == "privacy.marks" ? CountMarks(subject) : 0;

  public void Erase(DataSubject subject, DataCategory category) {
    if (category.Key == "privacy.marks") { ForgetMarks(subject); }
  }

  /// A mark says only which record is about somebody: it stays where a request finds it while the records it points
  /// at are kept out of use.
  public DateTime? Restrict(DataSubject subject, DataCategory category, bool untilLifted) => null;

  public ExportSection Export(DataSubject subject, DataCategory category) {
    if (category.Key == "privacy.marks") {
      return new ExportSection { Category = category.Key, Json = JsonSerializer.Serialize(MarksOf(subject)) };
    }
    var email = subject.Emails.Count > 0 ? subject.Emails[0] : "";
    var key = email == "" ? "-" : Security.Fingerprint(email);
    var mine = PrivacyRequest.Where(r => r.SubjectKey == key || (subject.Account != null && r.SubjectAccount == subject.Account))
      .Select(r => new { r.Right, r.ReceivedAt, r.State }).ToList();
    return new ExportSection { Category = category.Key, Json = JsonSerializer.Serialize(mine) };
  }

  /// Requests finished longer ago than their period, with their plans and files.
  public int Purge(DataCategory category, DateTime now) {
    if (category.Key != "privacy.records") { return 0; }
    var gone = 0;
    foreach (var r in PrivacyRequest.Where(r => r.State == RequestState.Done || r.State == RequestState.Failed).ToList()) {
      if (KeepUntil(category, r.ReceivedAt) > now) { continue; }
      // A held person's requests are evidence too: kept while the hold stands.
      if (IsKeyHeld(r.SubjectKey, r.SubjectAccount)) { continue; }
      foreach (var l in PlanLine.Where(l => l.Request == r).ToList()) { l.Delete(); }
      foreach (var f in ExportFetch.Where(f => f.Request == r).ToList()) { f.Delete(); }
      foreach (var a in PrivacyAsk.Where(a => a.Request == r).ToList()) { a.Delete(); }
      File.DeleteAbout(r);
      // A request is inbox work: its holding history and its clock name it, so they go with it.
      ForgetWorkItem(r);
      gone = gone + 1;
    }
    return gone;
  }
}
