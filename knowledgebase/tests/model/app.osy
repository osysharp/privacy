// Everything the museum says: who manages privacy, and who writes, reviews and arranges the visitor guide.
namespace PrivacyKnowledgeKitTests;

using Osysharp.Identity;
using Osysharp.WorkQueues;
using Osysharp.ServiceHours;
using Osysharp.KnowledgeBase;
using Osysharp.Privacy;

[Role] enum MuseumRole { Authenticator, Admin, Guide }

policy IsAdmin => RoleGrant.Any(g => g.Member == user && g.Role == MuseumRole.Admin);
policy IsGuide => RoleGrant.Any(g => g.Member == user && (g.Role == MuseumRole.Guide || g.Role == MuseumRole.Admin));
policy ManagesPrivacy => IsAdmin;
policy PlacesLegalHolds => IsAdmin;
policy WorksInbox => IsAdmin;
policy LeadsInbox => IsAdmin;
policy AdministersInbox => IsAdmin;
policy ManagesOrganizations => IsAdmin;
policy CollaboratesOnRecords => IsAdmin;
policy ReadsTeamKnowledge => IsGuide;
policy WritesKnowledge => IsGuide;
policy ReviewsKnowledge => IsAdmin;
policy ManagesKnowledge => IsAdmin;

/// The museum's people.
entity Person : Principal {
  [MaxLength(200)] string CodeHash = "";
  security {
    allow read when IsAuthenticated || IsAuthenticator;
    allow create when IsAuthenticator;
    deny read CodeHash when !IsAuthenticator;
  }
}

app.Knowledge = new KnowledgeSetup { Name = "Visitor guide" };

app = new() { Classifications = [ new Classification(Personal.Identity) { Open = true },
                                  new Classification(Personal.Content) { Open = true } ] };

[SuppressWarning("IMPORTED_ENTITY_HAS_NO_POLICY")] partial entity WorkItem { }
partial entity ServiceHours { security { allow read, create, update, delete when IsAdmin; } }
