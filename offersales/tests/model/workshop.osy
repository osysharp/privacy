// Everything the workshop says: its roles, who manages privacy and the queues, and who sells.

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.WorkQueues;
using Osysharp.Privacy;
using Osysharp.ServiceHours;
using Osysharp.Payments;
using Osysharp.OfferSales;

[Role] enum WorkshopRole { Authenticator, Customer, Manager }

policy IsManager => RoleGrant.Any(g => g.Member == user && g.Role == WorkshopRole.Manager);
policy ManagesPrivacy => IsManager;
policy PlacesLegalHolds => IsManager;
policy WorksInbox => IsManager;
policy LeadsInbox => IsManager;
policy AdministersInbox => IsManager;
policy ManagesOrganizations => IsManager;
policy CollaboratesOnRecords => IsManager;
policy ManagesOffers => IsManager;
policy SellsAtCounter => IsManager;

app.Accounts = new AccountsSetup { AppName = "Spoke & Chain", SignupRole = WorkshopRole.Customer };
app.Privacy = new PrivacySetup { Controller = "Spoke & Chain Ltd", SupervisoryAuthority = "ICO, ico.org.uk" };
app.OfferSales = new OfferSalesSetup { Providers = [ new ManualPayment { Key = "invoice", Label = "Invoice" } ], Currency = "GBP" };
app = new() {
  Name = "PrivacyOfferSalesKitTests",
  Classifications = [
    new Classification(Personal.Contact) { Roles = [WorkshopRole.Manager, WorkshopRole.Authenticator] },
    new Classification(Personal.Content) { Open = true },
  ],
};

[SuppressWarning("IMPORTED_ENTITY_HAS_NO_POLICY")] partial entity WorkItem { }
partial entity ServiceHours { security { allow read, create, update, delete when IsManager; } }
