// The producer's test project for Osysharp.Privacy.OfferSales — the smallest correct consumer: a bike repair workshop that
// sells servicing plans and answers privacy requests. A customer asks for a copy of what they bought, and to be erased.
app PrivacyOfferSalesKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.ServiceHours;
  use Osysharp.WorkQueues@0;
  use Osysharp.Privacy@0;
  use Osysharp.Payments@0;
  use Osysharp.OfferSales@0;
  // Osysharp.Privacy.OfferSales, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and OfferSales, which it completes (`osy lock` includes it and says so).
  use Osysharp.Storage;
  use Osysharp.Workflow;
  use Osysharp.Observability;
  use Osysharp.Ui;
}
