// ar (العربية): the words of Osysharp.Privacy, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations ar {
  // ── AskAboutAnAddress ──
  /// AskAboutAnAddress · an error message
  /// shown through ValidationException
  error "This browser cannot keep your request — let it keep cookies for this site and ask again." => "لا يمكن لهذا المتصفح الاحتفاظ بطلبك. اسمح له بحفظ ملفات تعريف الارتباط لهذا الموقع واطلب مجددًا.";

  // ── AskToLift ──
  /// AskToLift · an error message
  /// shown through ValidationException
  error "A lift is already waiting for a second person." => "يوجد طلب رفع بانتظار شخص ثانٍ بالفعل.";
  /// AskToLift · an error message
  /// shown through ValidationException
  error "Lifting a legal hold needs a reason — it is recorded, and it is what shows the hold was ended on purpose." => "رفع التجميد القانوني يتطلب سببًا، فهو يُسجَّل، وهو ما يثبت أن التجميد أُنهي عن قصد.";

  // ── AskWithProof ──
  /// AskWithProof · message
  /// shown through AskWithProof()
  /// also in AskAboutAnAddressWithProof
  message "We could not file it — ask again." => "تعذّر تقديمه، اطلب مجددًا.";

  // ── AskWithoutAnAccount ──
  /// AskWithoutAnAccount · a control's name for screen readers
  accessibleName "What this will do" => "ما الذي سيفعله هذا";
  /// AskWithoutAnAccount · a button's label · at most ~13 characters
  /// shown through Button.label
  /// also in RetentionEditor
  button "Confirm" => "تأكيد";
  /// AskWithoutAnAccount · a label (a field, a list item, a menu entry) · at most ~26 characters
  /// shown through Field.label
  /// beside: "Send me a code"
  label "Your email address" => "عنوان بريدك الإلكتروني";
  /// AskWithoutAnAccount · placeholder text inside an empty field · at most ~21 characters
  /// shown through Field.placeholder
  /// beside: "Send me a code"
  placeholder "you@example.com" => "you@example.com";
  /// AskWithoutAnAccount · a subtitle
  /// placeholders: {sentTo} = sentTo (string)
  /// shown through Card.subtitle
  subtitle "About {sentTo}, and nothing else." => "بخصوص {sentTo}، ولا شيء غيره.";
  /// AskWithoutAnAccount · a subtitle
  /// shown through PageHead.subtitle
  subtitle "No account needed — prove the email address you wrote to us from, and ask for a copy of what we hold, or to have it erased." => "لا حاجة إلى حساب: أثبت عنوان البريد الإلكتروني الذي راسلتنا منه، واطلب نسخة مما نحتفظ به، أو محوه.";
  /// AskWithoutAnAccount · a subtitle
  /// shown through Card.subtitle
  subtitle "We mail a code there. Only that address gets the answer." => "سنرسل رمزًا إليه. ولن يصل الرد إلا إلى ذلك العنوان.";
  /// AskWithoutAnAccount · a subtitle
  /// placeholders: {sentTo} = sentTo (string)
  /// shown through Card.subtitle
  subtitle "We sent a code to {sentTo}. It works for fifteen minutes." => "أرسلنا رمزًا إلى {sentTo}. صالح لمدة خمس عشرة دقيقة.";
  /// AskWithoutAnAccount · text on the page
  /// shown through problem
  text "Give the email address you wrote to us from." => "أدخل عنوان البريد الإلكتروني الذي راسلتنا منه.";
  /// AskWithoutAnAccount · text on the page
  /// shown through SectionLabel.text
  /// beside: "Send the request"
  text "What this will do" => "ما الذي سيفعله هذا";
  /// AskWithoutAnAccount · text on the page
  /// placeholders: {sentTo} = sentTo (string)
  /// shown through done
  text "Your request is in. We answer within one month, by mail to {sentTo} — and only there." => "تم استلام طلبك. سنرد خلال شهر واحد، عبر البريد إلى {sentTo}، وهناك فقط.";
  /// AskWithoutAnAccount · a title
  /// shown through Card.title
  title "1. Your email address" => "1. عنوان بريدك الإلكتروني";
  /// AskWithoutAnAccount · a title
  /// shown through Card.title
  title "2. The code" => "2. الرمز";
  /// AskWithoutAnAccount · a title
  /// shown through Card.title
  title "3. What you ask for" => "3. ما تطلبه";
  /// AskWithoutAnAccount · a title
  /// shown through PageHead.title
  /// also in AskWithoutAnAccountPage /privacy/ask
  title "Ask about your data" => "اسأل عن بياناتك";

  // ── AskedFor ──
  /// AskedFor · a title
  /// shown through AskedFor()
  title "Your request for a copy of your data" => "طلبك للحصول على نسخة من بياناتك";
  /// AskedFor · a title
  /// shown through AskedFor()
  title "Your request to erase your data" => "طلبك لمحو بياناتك";
  /// AskedFor · a title
  /// shown through AskedFor()
  title "Your request to move your data" => "طلبك لنقل بياناتك";
  /// AskedFor · a title
  /// shown through AskedFor()
  title "Your request to stop using your data" => "طلبك لإيقاف استخدام بياناتك";

  // ── CategoryOf ──
  /// CategoryOf · an error message
  /// placeholders: {key} = key (string), {Join} = string.Join(…) (string)
  /// shown through ValidationException
  error "No holder declares the category '{key}'. The categories are: {Join}." => "لا يعلن أي حائز للبيانات عن الفئة '{key}'. الفئات المتاحة: {Join}.";

  // ── ControllerEditor ──
  /// ControllerEditor · a control's name for screen readers
  accessibleName "Who is responsible" => "الجهة المسؤولة";
  /// ControllerEditor · a button's label · at most ~27 characters
  /// shown through Button.label
  button "Name the controller" => "تحديد المتحكّم";
  /// ControllerEditor · a description
  /// shown through SettingsSection.description
  description "Named in every answer, set by the app." => "يُذكر في كل رد، ويحدده التطبيق.";
  /// ControllerEditor · a description
  /// shown through SettingsSection.description
  /// beside: "Saved."
  description "The legal entity that decides why and how people's data is used here — usually the company running the app. Every answer to a privacy request names it, and so do the records of processing." => "الكيان القانوني الذي يقرر لماذا وكيف تُستخدم بيانات الأشخاص هنا، وهو عادةً الشركة التي تشغّل التطبيق. يُذكر اسمه في كل رد على طلب خصوصية، وفي سجلات المعالجة كذلك.";
  /// ControllerEditor · a hint under a field
  /// shown through Field.hint
  hint "Its registered name — what a person would look up." => "اسمه المسجَّل، وهو ما سيبحث عنه الشخص.";
  /// ControllerEditor · a label (a field, a list item, a menu entry) · at most ~16 characters
  /// shown through Field.label
  label "Legal name" => "الاسم القانوني";
  /// ControllerEditor · placeholder text inside an empty field · at most ~45 characters
  /// shown through Field.placeholder
  placeholder "As on the company's registration" => "كما في سجل الشركة";
  /// ControllerEditor · text on the page
  /// beside: "Name the controller"
  text "Name it here to say it in your own words." => "حدّده هنا لتكتبه بكلماتك.";
  /// ControllerEditor · text on the page
  /// placeholders: {fallback} = fallback (string)
  /// beside: "Name the controller"
  text "Named by the app as {fallback}." => "حدّده التطبيق باسم {fallback}.";
  /// ControllerEditor · text on the page
  /// beside: "Name the controller"
  text "Not named yet." => "لم يُحدَّد بعد.";
  /// ControllerEditor · text on the page
  /// beside: "Name the controller"
  text "Until it is, an answer says it comes from \"the people who run it\" — a person asking about their data is owed a name." => "وإلى أن يُحدَّد، يقول الرد إنه صادر عن «القائمين على التطبيق»، ومن حق من يسأل عن بياناته أن يعرف اسمًا.";
  /// ControllerEditor · text on the page
  /// shown through SaveBar.blockedBy
  /// beside: "The controller"
  text "Write the controller's legal name." => "اكتب الاسم القانوني للمتحكّم في البيانات.";
  /// ControllerEditor · a title
  /// shown through SettingsSection.title
  /// beside: "Saved."
  title "The controller" => "المتحكّم في البيانات";
  /// ControllerEditor · a title
  /// shown through SettingsSection.title
  title "Where a person can complain" => "أين يمكن للشخص تقديم شكوى";

  // ── ControllerSettings (/settings/privacy/controller) ──
  /// ControllerSettings · /settings/privacy/controller · a title
  /// shown through [Title]
  title "Who is responsible" => "الجهة المسؤولة";

  // ── ExportByLinkPage (/privacy/export/{link}) ──
  /// ExportByLinkPage · /privacy/export/{link} · a subtitle
  /// shown through PageHead.subtitle
  subtitle "A copy of what we hold about you. It can be downloaded once; after that, or after seven days, it is deleted." => "نسخة مما نحتفظ به عنك. يمكن تنزيلها مرة واحدة؛ وبعد ذلك، أو بعد سبعة أيام، تُحذف.";
  /// ExportByLinkPage · /privacy/export/{link} · a title
  /// shown through PageHead.title
  /// also in ExportByLinkPage /privacy/export/{link}
  title "Your data" => "بياناتك";

  // ── ExportSaved ──
  /// ExportSaved · message
  /// shown through Alert.message
  message "Open your-data.html in any browser to read it — each kind of data we hold about you, with why we keep it and for how long." => "افتح your-data.html في أي متصفح لقراءته: كل نوع من البيانات التي نحتفظ بها عنك، مع سبب الاحتفاظ بها ومدته.";
  /// ExportSaved · text on the page
  text "Download the data file another service can read (JSON)" => "تنزيل ملف البيانات الذي يمكن لخدمة أخرى قراءته (JSON)";
  /// ExportSaved · text on the page
  text "Download the readable copy again" => "تنزيل النسخة المقروءة مرة أخرى";
  /// ExportSaved · text on the page
  /// beside: "Download the readable copy again"
  text "These links work for a few minutes, and this copy can be downloaded only now — after that, ask again for a new one." => "تعمل هذه الروابط لبضع دقائق، ولا يمكن تنزيل هذه النسخة إلا الآن. بعد ذلك، اطلب نسخة جديدة.";
  /// ExportSaved · a title
  /// shown through Alert.title
  title "Your copy is downloading" => "جارٍ تنزيل نسختك";

  // ── ExtendDeadline ──
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "A deadline may be extended by one or two months, no more." => "يمكن تمديد المهلة شهرًا أو شهرين، لا أكثر.";
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "An extension needs its reason — the person is told it." => "يتطلب التمديد ذكر سببه، فسيتم إبلاغ الشخص به.";
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "The first month is over — an extension must be decided, and told, within it." => "انقضى الشهر الأول، ويجب أن يُقرَّر التمديد ويُبلَّغ به خلاله.";
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "This request is answered." => "تم الرد على هذا الطلب.";
  /// ExtendDeadline · an error message
  /// shown through ValidationException
  error "This request was already extended." => "تم تمديد هذا الطلب بالفعل.";

  // ── FactsOf ──
  /// FactsOf · text on the page
  /// shown through RequestFacts.Delivery
  text "Filed by staff: send the answer yourself, through a channel you proved. Nothing is mailed to the address typed in." => "قدّمه الفريق: أرسل الرد بنفسك، عبر قناة أثبتّها. لا يُرسل أي شيء بالبريد إلى العنوان المكتوب.";
  /// FactsOf · text on the page
  /// placeholders: {r.DeliverTo} = r.DeliverTo (string)
  /// shown through RequestFacts.Delivery
  text "Goes to {r.DeliverTo} — the address the person proved — when it is answered." => "يُرسل إلى {r.DeliverTo}، العنوان الذي أثبته الشخص، عند الرد عليه.";
  /// FactsOf · text on the page
  /// placeholders: {l.Reason} = l.Reason (string)
  /// shown through PlanRow.Detail
  text "Kept, restricted — {l.Reason}" => "محفوظة ومقيّدة: {l.Reason}";
  /// FactsOf · text on the page
  /// placeholders: {ToString} = ….ToString(…) (DateTime)
  /// shown through PlanRow.Detail
  text "Kept, restricted, through {ToString}" => "محفوظة، مع تقييد المعالجة، حتى {ToString}";
  /// FactsOf · text on the page
  /// placeholders: {PeriodWords} = PeriodWords(…) (string)
  /// shown through PlanRow.Detail
  text "Kept, restricted, {PeriodWords}" => "محفوظة، مع تقييد المعالجة، {PeriodWords}";
  /// FactsOf · text on the page
  /// placeholders: {ToString} = r.DeliveredAt.Value.ToString(…) (DateTime)
  /// shown through RequestFacts.Delivery
  text "Sent to the proven address on {ToString}." => "أُرسل إلى العنوان المُثبَت في {ToString}.";
  /// FactsOf · text on the page
  /// shown through RequestFacts.Asker
  text "an erased person (kept as a fingerprint)" => "شخص مُحيت بياناته (محفوظ كبصمة)";

  // ── FetchMyExport ──
  /// FetchMyExport · an error message
  /// shown through ValidationException
  /// also in FetchExportByLink
  error "That export has expired and was deleted — ask again for a new one." => "انتهت صلاحية هذا التصدير وحُذف. اطلبه مجددًا للحصول على تصدير جديد.";
  /// FetchMyExport · an error message
  /// shown through ValidationException
  /// also in FetchExportByLink
  error "That export was already downloaded — ask again for a new one." => "تم تنزيل هذا التصدير بالفعل. اطلبه مجددًا للحصول على تصدير جديد.";
  /// FetchMyExport · an error message
  /// shown through ValidationException
  error "That is not your request." => "هذا ليس طلبك.";

  // ── FileRequest ──
  /// FileRequest · an error message
  /// shown through ValidationException
  error "A step-up is the person's own proof on their privacy page — say how YOU checked it is them." => "التحقق الإضافي هو إثبات الشخص بنفسه في صفحة الخصوصية الخاصة به. اذكر كيف تحققت أنت من أنه هو.";
  /// FileRequest · an error message
  /// shown through ValidationException
  error "Say how you checked it is them — a fraudulent request is a known way to steal someone's data." => "اذكر كيف تحققت من أنه هو، فالطلب الاحتيالي أسلوب معروف لسرقة بيانات شخص ما.";
  /// FileRequest · an error message
  /// shown through ValidationException
  error "Say who the request is about — their address, their number, or their account." => "حدّد من يخصه الطلب: عنوانه، أو رقمه، أو حسابه.";

  // ── FromPhrase ──
  /// FromPhrase · text on the page
  text "from the end of its calendar year" => "من نهاية سنتها الميلادية";
  /// FromPhrase · text on the page
  text "from the end of its fiscal year" => "من نهاية سنتها المالية";
  /// FromPhrase · text on the page
  text "from the end of the calendar year its fiscal year ended in" => "من نهاية السنة الميلادية التي انتهت فيها سنتها المالية";
  /// FromPhrase · text on the page
  text "from when it was collected" => "من وقت جمعها";

  // ── HeldSentence ──
  /// HeldSentence · text on the page
  /// shown through HeldSentence()
  text "kept for the establishment, exercise or defence of legal claims" => null;

  // ── HeldWords ──
  /// HeldWords · text on the page
  /// shown through HeldWords()
  text "We cannot count these by person." => "لا يمكننا عدّ هذه حسب الشخص.";
  /// HeldWords · text on the page
  /// shown through HeldWords()
  text "We hold none of these about you." => "لا نحتفظ بأي منها عنك.";
  /// HeldWords · text on the page
  /// placeholders: {c.Held} = c.Held (int) — {c.Held} is a count: give one text per plural form
  /// shown through HeldWords()
  text "We hold {c.Held} of these about you." => { zero: "لا نحتفظ بأي منها عنك.", one: "نحتفظ بواحد منها عنك.", two: "نحتفظ باثنين منها عنك.", few: "نحتفظ بـ {c.Held} منها عنك.", many: "نحتفظ بـ {c.Held} منها عنك.", other: "نحتفظ بـ {c.Held} منها عنك." };

  // ── HoldControl ──
  /// HoldControl · a control's name for screen readers
  accessibleName "Legal hold" => "حجز قانوني";
  /// HoldControl · a button's label · at most ~33 characters
  /// shown through Button.label
  button "Lift it on Legal holds…" => "رفعه من صفحة الحجوزات القانونية…";
  /// HoldControl · a button's label · at most ~27 characters
  /// shown through Button.label
  button "Place a legal hold…" => "وضع حجز قانوني…";
  /// HoldControl · a button's label · at most ~20 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  button "Place the hold" => "فرض التجميد";
  /// HoldControl · a hint under a field
  /// shown through Field.hint
  /// beside: "Why it must be kept", "Review by", "Cancel"
  hint "Never shown to the customer." => "لا يُعرض على العميل أبدًا.";
  /// HoldControl · a hint under a field
  /// shown through DatePicker.hint
  /// beside: "Matter", "Why it must be kept", "Cancel"
  /// also in LegalHoldsEditor
  hint "When somebody looks at it again — a hold is never kept for ever unseen." => "موعد إعادة النظر فيه، فالتجميد لا يُبقى إلى الأبد دون مراجعة.";
  /// HoldControl · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through Field.label
  /// beside: "Why it must be kept", "Review by", "Cancel"
  /// also in LegalHoldsEditor
  label "Matter" => "القضية";
  /// HoldControl · a label (a field, a list item, a menu entry) · at most ~15 characters
  /// shown through DatePicker.label
  /// beside: "Matter", "Why it must be kept", "Cancel"
  /// also in LegalHoldsEditor
  label "Review by" => "المراجعة بحلول";
  /// HoldControl · a label (a field, a list item, a menu entry) · at most ~27 characters
  /// shown through Field.label
  /// beside: "Matter", "Review by", "Cancel"
  /// also in LegalHoldsEditor
  label "Why it must be kept" => "سبب وجوب الاحتفاظ بها";
  /// HoldControl · placeholder text inside an empty field · at most ~40 characters
  /// shown through Field.placeholder
  /// beside: "Why it must be kept", "Review by", "Cancel"
  placeholder "Dispute about a refund, 2026" => "نزاع حول استرداد مبلغ، 2026";
  /// HoldControl · placeholder text inside an empty field · at most ~69 characters
  /// shown through Field.placeholder
  /// beside: "Matter", "Review by", "Cancel"
  placeholder "The customer has said they will take it to court." => "قال العميل إنه سيرفع الأمر إلى المحكمة.";
  /// HoldControl · a subtitle
  /// shown through Dialog.subtitle
  subtitle "Nothing on it is erased on request or purged until the hold is lifted. The customer is told only that it is kept for legal claims." => "لا يُمحى شيء منه بناءً على طلب ولا يُحذف حتى يُرفع الحجز. ولا يُبلَّغ العميل إلا بأنه محفوظ لأغراض المطالبات القانونية.";
  /// HoldControl · text on the page
  /// placeholders: {ToString} = facts.ReviewBy.Value.ToString(…) (DateTime)
  /// beside: "Lift it on Legal holds…"
  text " — reviewed by {ToString}" => "، وتُراجَع قبل {ToString}";
  /// HoldControl · text on the page
  /// placeholders: {value} = … (string)
  /// beside: "Lift it on Legal holds…"
  text "Nothing on it is erased or purged until the hold is lifted{value}." => "لا يُمحى ولا يُحذف شيء منه حتى يُرفع الحجز{value}.";
  /// HoldControl · text on the page
  /// placeholders: {facts.Matter} = facts.Matter (string)
  text "On legal hold: {facts.Matter}" => "تحت حجز قانوني: {facts.Matter}";
  /// HoldControl · text on the page
  /// shown through problem
  text "Pick the date the hold is reviewed — a hold is never kept for ever unseen." => "اختر تاريخ مراجعة الحجز، فلا يبقى أي حجز إلى الأبد دون أن يراه أحد.";
  /// HoldControl · a title
  /// placeholders: {label} = label (string)
  /// shown through Dialog.title
  title "Place a legal hold on {label}" => "وضع حجز قانوني على {label}";

  // ── HoldReviewOf ──
  /// HoldReviewOf · text on the page
  /// shown through HoldReviewFacts.On
  /// also in HoldRows
  text "an account" => "حساب";

  // ── HoldReviewPane ──
  /// HoldReviewPane · a control's name for screen readers
  accessibleName "Legal hold review" => "مراجعة الحجز القانوني";
  /// HoldReviewPane · a control's name for screen readers
  accessibleName "What it is for" => "الغرض منه";
  /// HoldReviewPane · a button's label · at most ~20 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  button "Ask to lift it" => "طلب رفعه";
  /// HoldReviewPane · a button's label · at most ~12 characters
  /// shown through Button.label
  /// beside: "Keep it"
  /// also in HoldControl
  /// also in LegalHoldsEditor
  button "Cancel" => "إلغاء";
  /// HoldReviewPane · a button's label · at most ~13 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  button "Keep it" => "إبقاؤه";
  /// HoldReviewPane · a button's label · at most ~37 characters
  /// shown through Button.label
  /// beside: "Lift the hold…"
  button "Keep it, and review again…" => "إبقاؤه ومراجعته لاحقًا…";
  /// HoldReviewPane · a button's label · at most ~19 characters
  /// shown through Button.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  button "Lift the hold" => "رفع التجميد";
  /// HoldReviewPane · a button's label · at most ~20 characters
  /// shown through Button.label
  /// beside: "Keep it, and review again…"
  button "Lift the hold…" => "رفع الحجز…";
  /// HoldReviewPane · a hint under a field
  /// shown through Field.hint
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  hint "Recorded with your name." => "يُسجَّل باسمك.";
  /// HoldReviewPane · a label (a field, a list item, a menu entry) · at most ~10 characters
  /// shown through Badge.label
  /// also in LegalHoldsEditor
  label "Case" => "قضية";
  /// HoldReviewPane · a label (a field, a list item, a menu entry) · at most ~17 characters
  /// shown through DatePicker.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  label "Next review" => "المراجعة التالية";
  /// HoldReviewPane · a label (a field, a list item, a menu entry) · at most ~28 characters
  /// shown through Field.label
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  label "Why it can be lifted" => "سبب إمكانية رفعه";
  /// HoldReviewPane · placeholder text inside an empty field · at most ~45 characters
  /// shown through Field.placeholder
  /// beside: "Cancel"
  /// also in LegalHoldsEditor
  placeholder "Settled out of court on 3 March." => "تمت التسوية خارج المحكمة في 3 مارس.";
  /// HoldReviewPane · a subtitle
  /// shown through Dialog.subtitle
  /// also in LegalHoldsEditor
  subtitle "A second person confirms the lift. Until then it stays in force." => "يؤكد شخص ثانٍ الرفع. وحتى ذلك الحين يبقى التجميد ساريًا.";
  /// HoldReviewPane · a subtitle
  /// shown through Dialog.subtitle
  /// also in LegalHoldsEditor
  subtitle "Erasures that waited on it run, and anything past its period is purged at the next run." => "تُنفَّذ عمليات المحو التي كانت تنتظره، ويُحذف كل ما تجاوز مدته في التشغيل التالي.";
  /// HoldReviewPane · a subtitle
  /// shown through Dialog.subtitle
  subtitle "It stays in force; this review closes, and a new one opens on the date you pick." => "يبقى ساريًا، وتُغلق هذه المراجعة، وتُفتح مراجعة جديدة في التاريخ الذي تختاره.";
  /// HoldReviewPane · text on the page
  /// placeholders: {facts.On} = facts.On (string)
  text "A legal hold on {facts.On}" => "حجز قانوني على {facts.On}";
  /// HoldReviewPane · text on the page
  /// placeholders: {ToString} = next.Value.ToString(…) (DateOnly)
  /// shown through done
  text "Kept. Somebody looks at it again on {ToString}." => "أُبقي عليه. سيراجعه أحدهم مجددًا في {ToString}.";
  /// HoldReviewPane · text on the page
  /// shown through done
  /// also in LegalHoldsEditor
  text "Lifted. What waited on it — an erasure, a purge — runs now." => "تم الرفع. ما كان ينتظره، من محو أو حذف، يُنفَّذ الآن.";
  /// HoldReviewPane · text on the page
  /// beside: "Why it is kept"
  text "Matter" => "القضية";
  /// HoldReviewPane · text on the page
  /// shown through problem
  /// also in LegalHoldsEditor
  text "Pick the next review date." => "اختر تاريخ المراجعة التالي.";
  /// HoldReviewPane · text on the page
  /// placeholders: {facts.PlacedBy} = facts.PlacedBy (string), {ToString} = facts.PlacedAt.ToString(…) (DateTime)
  /// beside: "Matter", "Why it is kept"
  text "Placed by {facts.PlacedBy} on {ToString}." => "وضعه {facts.PlacedBy} في {ToString}.";
  /// HoldReviewPane · text on the page
  text "Settled — this review is closed." => "تمّت التسوية، وأُغلقت هذه المراجعة.";
  /// HoldReviewPane · text on the page
  /// shown through done
  text "The lift waits for a second person to confirm it on the legal holds page — the hold stays in force until then." => "ينتظر الرفع أن يؤكده شخص ثانٍ في صفحة الحجوزات القانونية، ويبقى الحجز ساريًا حتى ذلك الحين.";
  /// HoldReviewPane · text on the page
  /// beside: "Matter"
  text "Why it is kept" => "سبب الاحتفاظ به";
  /// HoldReviewPane · text on the page
  /// placeholders: {value} = … (string)
  text "{value}. While it stands nothing it covers is erased or purged — keep it only as long as the matter needs it." => "{value}. ما دام قائمًا لا يُمحى ولا يُحذف شيء مما يشمله، فأبقِه فقط ما دامت القضية تحتاج إليه.";
  /// HoldReviewPane · a title
  /// shown through Dialog.title
  title "Keep the hold" => "إبقاء الحجز";
  /// HoldReviewPane · a title
  /// placeholders: {facts.On} = facts.On (string)
  /// shown through Dialog.title
  title "Lift the hold on {facts.On}" => "رفع الحجز عن {facts.On}";

  // ── HowLongWords ──
  /// HowLongWords · text on the page
  /// placeholders: {PeriodWords} = PeriodWords(…) (string)
  /// also in KeptOf
  text "If you ask us to erase it, it is kept {PeriodWords}, used for this purpose only, then deleted." => "إذا طلبت منا محوها، نحتفظ بها {PeriodWords}، ولا تُستخدم إلا لهذا الغرض، ثم تُحذف.";
  /// HowLongWords · text on the page
  text "Until you ask us to erase it." => "إلى أن تطلب منا محوها.";

  // ── InTheCopy ──
  /// InTheCopy · text on the page
  /// placeholders: {HeldOf} = HeldOf(…) (int) — {HeldOf} is a count: give one text per plural form
  /// shown through InTheCopy()
  text "In your copy: {HeldOf} of these, each with its date — and why we keep them, and for how long." => { zero: "في نسختك: لا شيء منها، لكل منها تاريخه، مع سبب الاحتفاظ بها ومدته.", one: "في نسختك: واحد منها، لكل منها تاريخه، مع سبب الاحتفاظ بها ومدته.", two: "في نسختك: اثنان منها، لكل منها تاريخه، مع سبب الاحتفاظ بها ومدته.", few: "في نسختك: {HeldOf} منها، لكل منها تاريخه، مع سبب الاحتفاظ بها ومدته.", many: "في نسختك: {HeldOf} منها، لكل منها تاريخه، مع سبب الاحتفاظ بها ومدته.", other: "في نسختك: {HeldOf} منها، لكل منها تاريخه، مع سبب الاحتفاظ بها ومدته." };

  // ── KeepOnCompellingGrounds ──
  /// KeepOnCompellingGrounds · an error message
  /// placeholders: {line.Category} = line.Category (string)
  /// shown through ValidationException
  error "'{line.Category}' is not held on a legitimate interest, so there are no grounds to weigh." => "لا تُحفظ '{line.Category}' على أساس مصلحة مشروعة، فلا توجد مبررات للموازنة بينها.";
  /// KeepOnCompellingGrounds · an error message
  /// shown through ValidationException
  error "Keeping data a person asked to have erased needs the compelling grounds written down — they are told to the person." => "الاحتفاظ ببيانات طلب صاحبها محوها يتطلب تدوين المبررات القاهرة، وسيتم إبلاغ الشخص بها.";
  /// KeepOnCompellingGrounds · an error message
  /// shown through ValidationException
  error "Only a plan waiting for approval can be changed." => "لا يمكن تغيير إلا خطة بانتظار الموافقة.";

  // ── KeptOf ──
  /// KeptOf · text on the page
  text "Erased when you ask us to." => "تُمحى عندما تطلب منا ذلك.";

  // ── LegalHoldsEditor ──
