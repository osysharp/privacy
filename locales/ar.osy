  /// also in AskWithoutAnAccount
  button "Send the request" => "إرسال الطلب";
  /// MyPrivacy · a button's label · at most ~28 characters
  /// shown through AskChoice.title
  /// beside: "A copy of your data", "Move your data", "Erase your data"
  button "Stop using your data" => "إيقاف استخدام بياناتك";
  /// MyPrivacy · a label (a field, a list item, a menu entry) · at most ~10 characters
  /// shown through Field.label
  /// also in AskWithoutAnAccount
  label "Code" => "الرمز";
  /// MyPrivacy · a subtitle
  /// placeholders: {ToString} = r.AnswerBy.Value.ToString(…) (DateTime)
  /// shown through Card.subtitle
  subtitle " · we answer by {ToString}" => " · سنرد بحلول {ToString}";
  /// MyPrivacy · a subtitle
  /// shown through Card.subtitle
  subtitle "Before anything happens, this is what your request does to each kind of data we hold." => "قبل أن يحدث أي شيء، هذا ما سيفعله طلبك بكل نوع من البيانات التي نحتفظ بها.";
  /// MyPrivacy · a subtitle
  /// placeholders: {ToString} = r.ReceivedAt.ToString(…) (DateTime), {value} = … (string)
  /// shown through Card.subtitle
  subtitle "Received {ToString}{value}" => "تم الاستلام {ToString}{value}";
  /// MyPrivacy · a subtitle
  /// shown through PageHead.subtitle
  /// beside: "Ask us", "Your requests", "What we keep"
  subtitle "What we keep about you, why, and for how long — and how to ask for a copy, or to have it erased." => "ما نحتفظ به عنك، ولماذا، وإلى متى، وكيف تطلب نسخة منه أو محوه.";
  /// MyPrivacy · text on the page
  /// shown through SectionLabel.text
  text "Ask us" => "اسألنا";
  /// MyPrivacy · text on the page
  /// beside: "What we keep about people, and why"
  text "Beside each kind, how much of it we hold about you right now. Only how many — what they say is in a copy of your data." => "بجانب كل نوع، مقدار ما نحتفظ به منه عنك الآن. العدد فقط، أما محتواه ففي نسخة من بياناتك.";
  /// MyPrivacy · text on the page
  /// shown through AskChoice.body
  /// beside: "Move your data", "Erase your data", "Stop using your data"
  /// also in AskWithoutAnAccount
  text "Everything we hold about you, and why we keep it." => "كل ما نحتفظ به عنك، وسبب احتفاظنا به.";
  /// MyPrivacy · text on the page
  /// placeholders: {Join} = string.Join(…) (string)
  text "Not in a copy, because nobody can find it by person: {Join}." => "ليست في أي نسخة، لأنه لا يمكن لأحد العثور عليها حسب الشخص: {Join}.";
  /// MyPrivacy · text on the page
  /// placeholders: {Join} = string.Join(…) (string)
  text "Not in your copy, because we hold none of these about you: {Join}." => "ليست في نسختك، لأننا لا نحتفظ بأي منها عنك: {Join}.";
  /// MyPrivacy · text on the page
  /// beside: "Download your data"
  text "Once, within seven days of the answer." => "مرة واحدة، خلال سبعة أيام من الرد.";
  /// MyPrivacy · text on the page
  /// beside: "Cancel"
  text "To be sure it is you, we mail a code to the address on your account." => "للتأكد من أنك أنت، نرسل رمزًا إلى العنوان المسجّل في حسابك.";
  /// MyPrivacy · text on the page
  /// shown through askProblem
  /// also in AskWithoutAnAccount
  text "Type the code from the mail." => "اكتب الرمز من رسالة البريد.";
  /// MyPrivacy · text on the page
  /// shown through AskChoice.body
  /// beside: "A copy of your data", "Move your data", "Stop using your data"
  /// also in AskWithoutAnAccount
  text "We erase what we may, and tell you what the law makes us keep." => "نمحو ما يجوز لنا محوه، ونخبرك بما يُلزمنا القانون بالاحتفاظ به.";
  /// MyPrivacy · text on the page
  /// shown through AskChoice.body
  /// beside: "A copy of your data", "Move your data", "Erase your data"
  text "We keep it, but use it for nothing until you say so." => "نحتفظ بها، لكن لا نستخدمها في أي شيء حتى تأذن بذلك.";
  /// MyPrivacy · text on the page
  /// placeholders: {sentTo} = sentTo (string)
  /// beside: "240px", "Cancel"
  text "We sent a code to {sentTo}. It works for fifteen minutes." => "أرسلنا رمزًا إلى {sentTo}. صالح لمدة خمس عشرة دقيقة.";
  /// MyPrivacy · text on the page
  /// shown through SectionLabel.text
  /// beside: "Beside each kind, how much of it we hold about you right now. Only how many — what they say is in a copy of your data."
  text "What we keep about people, and why" => "ما نحتفظ به عن الأشخاص، ولماذا";
  /// MyPrivacy · text on the page
  /// shown through AskChoice.body
  /// beside: "A copy of your data", "Erase your data", "Stop using your data"
  text "What you gave us, in a file another service can read." => "ما قدّمته لنا، في ملف يمكن لخدمة أخرى قراءته.";
  /// MyPrivacy · text on the page
  /// shown through EmptyState.body
  text "When you ask us for a copy of your data, or to erase it, it shows here until it is answered — and after." => "عندما تطلب منا نسخة من بياناتك، أو محوها، يظهر الطلب هنا حتى يتم الرد عليه، وبعد ذلك أيضًا.";
  /// MyPrivacy · text on the page
  /// shown through done
  text "Your request is in. We answer within one month — by mail to the address you just confirmed, and here." => "تم استلام طلبك. سنرد خلال شهر واحد، عبر البريد إلى العنوان الذي أكدته للتو، وهنا.";
  /// MyPrivacy · text on the page
  /// shown through SectionLabel.text
  text "Your requests" => "طلباتك";
  /// MyPrivacy · a title
  /// shown through EmptyState.title
  title "No requests yet" => "لا توجد طلبات بعد";
  /// MyPrivacy · a title
  /// shown through Card.title
  title "What this will do" => "ما الذي سيفعله هذا";
  /// MyPrivacy · a title
  /// shown through PageHead.title
  /// beside: "Ask us", "Your requests", "What we keep"
  /// also in MyPrivacyPage /privacy
  title "Your privacy" => "خصوصيتك";

  // ── MyRequestRows ──
  /// MyRequestRows · text on the page
  /// placeholders: {ToString} = fetched.At.ToString(…) (DateTime)
  /// shown through MyRequestRow.ExportWords
  text "Downloaded on {ToString}." => "تم التنزيل في {ToString}.";
  /// MyRequestRows · text on the page
  /// placeholders: {ToString} = r.ExportExpiresAt.Value.ToString(…) (DateTime)
  /// shown through MyRequestRow.ExportWords
  text "Not downloaded, so deleted on {ToString}. Ask again for a new copy." => "لم يتم التنزيل، لذا حُذف في {ToString}. اطلب نسخة جديدة مرة أخرى.";
  /// MyRequestRows · text on the page
  /// placeholders: {r.ExtensionReason} = r.ExtensionReason (string)
  /// shown through MyRequestRow.Extension
  text "We need more time: {r.ExtensionReason}" => "نحتاج إلى مزيد من الوقت: {r.ExtensionReason}";

  // ── NewHold ──
  /// NewHold · an error message
  /// shown through ValidationException
  error "A hold needs a review date in the future — a hold is reviewed, so it never becomes keeping for ever." => "يحتاج التجميد إلى تاريخ مراجعة في المستقبل، فالتجميد يُراجَع حتى لا يصبح احتفاظًا إلى الأبد.";
  /// NewHold · an error message
  /// shown through ValidationException
  error "Name the matter the hold is for — it is what a reviewer reads." => "سمِّ القضية التي يخصها التجميد، فهذا ما يقرؤه المراجع.";
  /// NewHold · an error message
  /// shown through ValidationException
  error "Say why the data must be kept — a hold without a reason cannot be reviewed." => "اذكر سبب وجوب الاحتفاظ بالبيانات، فالتجميد بلا سبب لا يمكن مراجعته.";

  // ── NoSelfService ──
  /// NoSelfService · message
  /// placeholders: {value} = … (string)
  /// shown through NoSelfService()
  message "This app cannot confirm it is you yet, so a request is made by writing to {value} — they will check it is you." => "لا يمكن لهذا التطبيق التأكد من هويتك بعد، لذا يُقدَّم الطلب بالكتابة إلى {value}، وسيتحققون من أنك أنت.";
  /// NoSelfService · message
  /// shown through NoSelfService()
  message "the people who run it" => "القائمين عليه";

