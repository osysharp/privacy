// Osysharp.Privacy.Qualifications — a person's qualifications as Osysharp.Privacy's holder: what they hold, what they signed
// and on which text, and the files behind them — in their copy of their data and erased when they ask.
//
// ⚑ AN ADAPTER, SO NEITHER KIT DEPENDS ON THE OTHER: Qualifications does not force privacy requests on an app that only
//   records inductions, and Privacy does not force qualifications on its apps. An app using both gets it by itself —
//   `completes` below, and `osy lock` says so — the holder is DISCOVERED, nothing is wired.
package Osysharp.Privacy.Qualifications {
  version     "0.2.0";
  minPlatform "0.14.0";
  summary     "Osysharp.Privacy's holder for Osysharp.Qualifications — the qualifications a person holds, what they signed and on which text, and the evidence files, in their copy of their data and erased when they ask.";
  completes   Osysharp.Privacy@0, Osysharp.Qualifications@0;
  model "model/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.Qualifications@0;
  use Osysharp.Privacy@0;
  tests "tests";
}
