// A member's qualifications under their privacy request: counted, copied out (with the exact text they signed), and
// erased with their files — theirs only.

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Privacy;
using Osysharp.Storage;
using Osysharp.Qualifications;
using Osysharp.Privacy.Qualifications;

[TestFixture]
void Space() {
  var ann = new User { Email = "ann@space.test", DisplayName = "Ann", EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = ann, Role = SpaceRole.Member };
  var bo = new User { Email = "bo@space.test", DisplayName = "Bo", EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = bo, Role = SpaceRole.Member };
  var sam = new User { Email = "sam@space.test", DisplayName = "Sam", EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = sam, Role = SpaceRole.Steward };
  new QualificationKind { Key = "laser-induction", Name = "Laser cutter induction", Category = QualificationCategory.Induction, ValidForMonths = 24 };
  var rules = new QualificationKind { Key = "workshop-rules", Name = "Workshop rules", Category = QualificationCategory.Waiver, SignedByHolder = true };
  new QualificationText { Kind = rules, Version = 1, Body = "I never leave a running machine unattended." };
}

principal Ann => User.Single(u => u.Email == "ann@space.test");
principal Bo => User.Single(u => u.Email == "bo@space.test");
principal Sam => User.Single(u => u.Email == "sam@space.test");

/// Ann signed the rules and holds an induction with a scan behind it; Bo holds an induction.
void Held() {
  runas(Ann) { SignQualification(Ann, QualificationText.Single(t => t.Version == 1), "Ann Smith"); }
  var induction = RecordQualification(Ann, "laser-induction", null, "LC-118");
  AttachEvidence(induction, File.Create("induction.pdf", "application/pdf", Encoding.UTF8.GetBytes("%PDF-1.4 signed sheet")));
  RecordQualification(Bo, "laser-induction");
}

[Test(Space)]
[runas(Sam)]
void her_copy_lists_what_she_holds_and_the_text_she_signed() {
  Held();
  var holder = new QualificationsPersonalData();
  var ann = new DataSubject { Account = Ann.Id };
  Assert.Equal(3, holder.Count(ann, CategoryOf("qualifications")));
  var copy = holder.Export(ann, CategoryOf("qualifications"));
  Assert.Contains("LC-118", copy.Json);
  Assert.Contains("I never leave a running machine unattended.", copy.Json);
  Assert.Contains("induction.pdf", copy.Json);
  Assert.Equal(3, copy.Items.Count);
  Assert.Equal(1, holder.Count(new DataSubject { Account = Bo.Id }, CategoryOf("qualifications")));
}

[Test(Space)]
[runas(Sam)]
void an_erasure_takes_her_qualifications_and_files_and_leaves_his() {
  Held();
  var r = FileRequest(RequestKind.Erasure, Ann.Id, "", IdentityCheck.InPerson, "Asked at the front desk.");
  Assert.Equal(3, PlanLine.Single(l => l.Request == r && l.Category == "qualifications").Items);
  ApproveRequest(r);
  Assert.Equal(RequestState.Done, PrivacyRequest.Single(x => x.Id == r.Id).State);
  Assert.Equal(0, QualificationsOf(Ann).Count);
  Assert.Equal(0, QualificationEvidence.Count());
  Assert.True(HasValidQualification(Bo, "laser-induction"));
  Assert.NoTraceOf("LC-118");
}
