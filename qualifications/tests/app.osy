// The producer's test project for Osysharp.Privacy.Qualifications — the smallest correct consumer: a makerspace whose
// members need a tool induction and sign the workshop rules, and which answers privacy requests. A member's qualifications,
// what they signed and their files are in their copy of their data, and go when they are erased — theirs only.
app PrivacyQualificationsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.ServiceHours;
  use Osysharp.WorkQueues@1;
  use Osysharp.Privacy@0;
  use Osysharp.Qualifications@0;
  // Osysharp.Privacy.Qualifications, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and Qualifications, which it completes (`osy lock` includes it and says so).
  use Osysharp.Storage;
}
