// The producer's test project for Osysharp.Privacy.WorkRepositories — a design studio hiring an illustrator. The
// hire is one assignment; its repository holds the brief, each candidate's application, what each interviewer
// thought of them, and the letters. Feedback is read by fewer people and kept for a year; applications for six
// months after the hire closes; letters for thirty days. A candidate asks for her copy, withdraws and is erased —
// and the other candidate, the hire and everybody's access are as they were.
app Recruiting {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.WorkQueues@1;
  use Osysharp.ServiceHours;
  use Osysharp.Mail@0;
  use Osysharp.Privacy@0;
  use Osysharp.Assignments@2;
  use Osysharp.WorkRepositories@1;
  use Osysharp.Llm@2;
  // Osysharp.Privacy.WorkRepositories, the package under test, is not written: it arrives by itself because this app
  // uses Privacy and WorkRepositories, which it completes (`osy lock` includes it and says so). So does
  // Osysharp.Privacy.Assignments.
  use Osysharp.Observability;
  use Osysharp.Workflow;
  use Osysharp.Storage;
  use Osysharp.Ui;
}
