// Osysharp.Privacy.Agents — what the app's AI agents did for a person and about a person, as Osysharp.Privacy's holder:
// found by the account the work was for and by what the app marked it as about, in their copy of their data, kept out
// of use when they ask, erased when they ask — and gone for everybody when its time is up.
//
//     var outcome = await Agents.Of<Desk>().Do(new DraftReminder(), loan);
//     MarkAgentWorkAbout(outcome.Task, new DataSubject { Emails = [loan.BorrowerEmail] });   // whose data it is
//
// ⚑ TWO THINGS ARE KEPT FOR DIFFERENT TIMES. What the work SAID — what the agent was shown, what each tool was given
//   and answered, what it handed back — is `agents.trace`: a month by default. THAT it happened — which agent and
//   skill, each step with its model, tool and cost, how it ended, and the chain that proves none of it was changed —
//   is `agents.record`: seven months by default (the EU AI Act asks for six where it applies).
//
// ⚑ AN ERASURE KEEPS THE CHAIN. The agents kit chains a record through the hashes of its words, not the words, so
//   after a person is erased `VerifyTrace` still answers intact for every piece of work they were in, and still finds
//   a line that was changed afterwards.
//
// ⚑ AN ADAPTER, SO NEITHER KIT DEPENDS ON THE OTHER: an app that uses Osysharp.Privacy and Osysharp.Agents writes
//   nothing to get it — `completes` below, and `osy lock` says so. The holder is DISCOVERED, nothing is wired.
package Osysharp.Privacy.Agents {
  version     "1.2.0";
  minPlatform "0.15.0";
  summary     "Osysharp.Privacy's holder for Osysharp.Agents — what the app's AI agents did for a person and about a person: found by the account it was for and by what the app marked it as about, in their copy of their data, kept out of use on request, erased on request while every record's hash chain still verifies, its content gone after a month and the record after seven for everybody, with legal holds honoured.";
  completes   Osysharp.Privacy@0, Osysharp.Agents@1;
  model "model/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.Agents@1;
  use Osysharp.Privacy@0;
  tests "tests";
}
