// The desk's agent, its model, and how it answers privacy requests. In a file of its own with no `namespace`.
using Osysharp.Agents;
using Osysharp.Llm;
using Osysharp.Privacy;
using Osysharp.WorkQueues;
using LostProperty;

app.Llm = new LlmSetup {
  Models = [
    new LlmModel { Name = "Small", Client = new ScriptedModel { Name = "Small" }, Model = "scripted-small",
                   Price = new LlmPrice { Input = 1, Output = 5 }, MaxOutputTokens = 1000 },
  ],
  Default = "Small",
};
app.Agents = new AgentsSetup { Agents = [new Matcher()], TaskBudget = 0.05m };
app.Privacy = new PrivacySetup { Controller = "Northsound Ferries AB", SupervisoryAuthority = "IMY, imy.se" };
app.Inbox = new InboxSetup { DefaultQueue = "Lost property" };
