// The producer's test project for Osysharp.Privacy.Agents.HumanRequests — a ferry line's lost-property desk, where a
// clerk hands a claim to an agent that matches it against what was found aboard, and a clerk who leaves asks to be
// erased.
app LostProperty {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Agents@1;
  use Osysharp.Agents.Testing@1;
  use Osysharp.Agents.HumanRequests@1;
  use Osysharp.Privacy.Agents.HumanRequests@1;
  use Osysharp.HumanRequests@1;
  use Osysharp.Privacy@0;
  use Osysharp.WorkQueues@1;
  use Osysharp.Llm@2;
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.Mail@0;
  use Osysharp.Observability;
  use Osysharp.Workflow;
  use Osysharp.ServiceHours;
  use Osysharp.Storage;
  use Osysharp.Ui;
}
