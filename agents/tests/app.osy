// The producer's test project for Osysharp.Privacy.Agents — a town library whose desk is an AI agent. Members ask it
// to renew their loans; a librarian has it draft a reminder about a borrower who never made an account. A member asks
// for her copy of what the library holds, and then to be erased: what the agent was shown and answered for her goes,
// she is taken off the record, and the record still proves what happened. Nobody else's work is touched.
// No model is ever called: its one model is scripted.
app Library {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.WorkQueues@1;
  use Osysharp.ServiceHours;
  use Osysharp.Mail@0;
  use Osysharp.Privacy@0;
  use Osysharp.Agents@1;
  use Osysharp.Agents.Testing@1;
  use Osysharp.Llm@2;
  // A late loan is chased as an assignment, the desk's work attached to it and its result kept in the repository —
  // so the family's other holders arrive too, and one request reaches all of it.
  use Osysharp.Assignments@2;
  use Osysharp.Assignments.Agents@1;
  use Osysharp.WorkRepositories@1;
  use Osysharp.WorkRepositories.Agents@1;
  use Osysharp.Ui;
  // Osysharp.Privacy.Agents, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and Agents, which it completes (`osy lock` includes it and says so).
  use Osysharp.Observability;
  use Osysharp.Workflow;
  use Osysharp.Storage;
}
