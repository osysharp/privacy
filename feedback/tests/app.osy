// The producer's test project for Osysharp.Privacy.Feedback — the smallest correct consumer: a ferry line that asks its
// passengers how the crossing went and answers privacy requests. A passenger asks for her data, and then to be erased;
// her answers go with her, and nobody else's.
app PrivacyFeedbackKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.Accounts@0;
  use Osysharp.Collaboration@0;
  use Osysharp.Inbox@0;
  use Osysharp.ServiceHours;
  use Osysharp.Mail@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.Feedback@0;
  use Osysharp.Privacy@0;
  // Osysharp.Privacy.Feedback, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and Feedback, which it completes (`osy lock` includes it and says so).
  use Osysharp.Observability;
}
