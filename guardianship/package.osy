// Osysharp.Privacy.Guardianship — what Osysharp.Guardianship holds about a person, as Osysharp.Privacy's holder: who
// looks after them and whom they look after, their date of birth and care notes, the consents answered for them, their
// emergency contacts, and the invitations to their address — in their copy of their data, and erased when they ask.
//
// ⚑ AN ADAPTER, SO NEITHER KIT DEPENDS ON THE OTHER: Guardianship does not force privacy requests on an app that only
//   links families, and Privacy does not force families on its apps. An app using both gets it by itself — `completes`
//   below, and `osy lock` says so — the holder is DISCOVERED, nothing is wired.
package Osysharp.Privacy.Guardianship {
  version     "0.2.0";
  minPlatform "0.14.0";
  summary     "Osysharp.Privacy's holder for Osysharp.Guardianship — who looks after a person and whom they look after, their date of birth and care notes (special-category data), the consents answered for them, their emergency contacts and the invitations to their address: counted, in their copy of their data, and erased when they ask.";
  completes   Osysharp.Privacy@0, Osysharp.Guardianship@0;
  model "model/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.Guardianship@0;
  use Osysharp.Privacy@0;
  tests "tests";
}
