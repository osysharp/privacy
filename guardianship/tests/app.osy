// The producer's test project for Osysharp.Privacy.Guardianship — the smallest correct consumer: a youth choir whose
// parents add their children, and which answers privacy requests. A child leaves and is erased; a parent asks for their
// copy.
app PrivacyGuardianshipKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.ServiceHours;
  use Osysharp.WorkQueues@0;
  use Osysharp.Privacy@0;
  use Osysharp.Guardianship@0;
  // Osysharp.Privacy.Guardianship, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and Guardianship, which it completes (`osy lock` includes it and says so).
  use Osysharp.Workflow;
  use Osysharp.Observability;
  use Osysharp.Ui;
  use Osysharp.Oauth;
}
