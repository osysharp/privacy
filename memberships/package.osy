// Osysharp.Privacy.Memberships — a person's memberships as Osysharp.Privacy's holder: what they held, who else it let
// in, every change to it and every time they came (or were turned away), in their copy of their data and erased when
// they ask.
//
// ⚑ AN ADAPTER, SO NEITHER KIT DEPENDS ON THE OTHER: Memberships does not force privacy requests on an app that sells day
//   tickets, and Privacy does not force memberships on its apps. An app using both gets it by itself — `completes`
//   below, and `osy lock` says so — the holder is DISCOVERED, nothing is wired. The visits on a counted membership are
//   Osysharp.PrepaidCredits', whose own holder (Osysharp.Privacy.PrepaidCredits) arrives the same way.
package Osysharp.Privacy.Memberships {
  version     "0.1.0";
  minPlatform "0.9.0";
  summary     "Osysharp.Privacy's holder for Osysharp.Memberships — a person's memberships, who else they let in, every change and every visit, in their copy of their data and erased when they ask.";
  completes   Osysharp.Privacy@0, Osysharp.Memberships@0;
  model "model/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.PrepaidCredits@0;
  use Osysharp.Memberships@0;
  use Osysharp.Privacy@0;
  tests "tests";
}
