// The producer's test project for Osysharp.Privacy.Memberships — the smallest correct consumer: a leisure centre that
// sells memberships and answers privacy requests. A member's memberships and visits are in their copy of their data,
// and go when they are erased — theirs, and nobody else's; the visits on a card go with Osysharp.Privacy.PrepaidCredits.
app PrivacyMembershipsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.ServiceHours;
  use Osysharp.WorkQueues@1;
  use Osysharp.Privacy@0;
  use Osysharp.PrepaidCredits@0;
  use Osysharp.Memberships@0;
  // Osysharp.Privacy.Memberships, the package under test, is not written: it arrives by itself because this app uses
  // Privacy and Memberships, which it completes (`osy lock` includes it and says so).
  use Osysharp.Workflow;
  use Osysharp.Observability;
}
